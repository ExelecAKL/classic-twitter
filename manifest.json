{
  "manifest_version": 3,
  "name": "Classic Twitter Light",
  "version": "1.3.6",
  "description": "Bring the blue bird, classic Light and Dim themes, and familiar Tweet wording back to X.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "styles/twitter-light.css",
        "styles/twitter-2019-refinement.css",
        "styles/twitter-2019-leak-fixes.css",
        "styles/twitter-2019-stable-hooks.css",
        "styles/twitter-2019-v12-final.css",
        "styles/twitter-v13.css"
      ],
      "js": [
        "scripts/v13-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/twitter-bird.svg",
        "assets/twitter-login-background.png",
        "assets/twitter-home-outline.svg",
        "assets/twitter-home-filled.svg",
        "styles/twitter-chat.css"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
